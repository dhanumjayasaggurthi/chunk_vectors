# The local UI and sample documents work without cloud credentials.
APP_MODE=demo
DATABASE_URL=sqlite:///evidenceflow.db

# Live settings are injected via environment/secrets in an approved deployment.
# APP_MODE=live
# DATABASE_URL=postgresql+psycopg://app:<secret>@db.internal:5432/evidenceflow
# SF_METADATA_TABLE=DEV_RAW.RIMDOCS_CONTROL_STG.ALL_METADATA_JOINED_WITH_IA_CII
# SF_ENTITLEMENTS_TABLE=SECURITY.APP_RIMDOCS_DOCUMENT_ACCESS
# ALLOWED_S3_BUCKETS=itx-bjv-rddlx-prod
# ALLOWED_S3_PREFIXES=landing/regulatory/rimdocs/Rimdocs_Extract_Prod/Safety/
# CHECKPOINT_BUCKET=private-evidenceflow-checkpoints
# CHECKPOINT_PREFIX=evidenceflow/checkpoints/
# SQS_TASK_URL=https://sqs.us-east-1.amazonaws.com/<account>/evidenceflow-tasks
# SQS_INTERACTIVE_URL=https://sqs.us-east-1.amazonaws.com/<account>/evidenceflow-interactive
# MAX_PDF_MB=1200
# MAX_PDF_PAGES=20000
# CHUNK_PAGES=64
# OCR_ENGINE=textract_async
# OIDC_ISSUER=https://identity.example.com/issuer
# OIDC_AUDIENCE=api://evidenceflow
# OIDC_JWKS_URL=https://identity.example.com/jwks
# JNJ_CONFIG_PATH=/secure/config.ini
# LLM_KIND=gpt4o
# EXTRACTION_PROFILE_VERSION=pbrer-v2

# Do not use shared browser API tokens. Corporate OIDC is mandatory in live mode.
